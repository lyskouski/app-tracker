CREATE TABLE Habit (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    icon TEXT,
    color TEXT,
    remarks TEXT
);

CREATE TABLE DayState (
    habitId INTEGER NOT NULL,
    date TEXT NOT NULL,
    mark TEXT NOT NULL,
    PRIMARY KEY (habitId, date),
    FOREIGN KEY (habitId) REFERENCES Habit(id)
);

CREATE TABLE Setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

selectAllSettings:
SELECT *
FROM Setting;

upsertSetting:
INSERT OR REPLACE INTO Setting(key, value)
VALUES (?, ?);

deleteSetting:
DELETE FROM Setting
WHERE key = ?;

selectAllHabits:
SELECT *
FROM Habit
ORDER BY id;

insertHabit:
INSERT INTO Habit(title, icon, color, remarks)
VALUES (?, ?, ?, ?);

updateHabit:
UPDATE Habit
SET title = ?, icon = ?, color = ?, remarks = ?
WHERE id = ?;

deleteDayStatesForHabit:
DELETE FROM DayState
WHERE habitId = ?;

deleteHabit:
DELETE FROM Habit
WHERE id = ?;

selectDayStatesForDateRange:
SELECT *
FROM DayState
WHERE date BETWEEN ? AND ?
ORDER BY habitId, date;

upsertDayState:
INSERT OR REPLACE INTO DayState(habitId, date, mark)
VALUES (?, ?, ?);

