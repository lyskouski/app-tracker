CREATE TABLE Habit (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    icon TEXT,
    color TEXT
);

CREATE TABLE DayState (
    habitId INTEGER NOT NULL,
    date TEXT NOT NULL,
    mark TEXT NOT NULL,
    PRIMARY KEY (habitId, date),
    FOREIGN KEY (habitId) REFERENCES Habit(id)
);

selectAllHabits:
SELECT *
FROM Habit
ORDER BY id;

insertHabit:
INSERT INTO Habit(title, icon, color)
VALUES (?, ?, ?);

selectDayStatesForDateRange:
SELECT *
FROM DayState
WHERE date BETWEEN ? AND ?
ORDER BY habitId, date;

upsertDayState:
INSERT OR REPLACE INTO DayState(habitId, date, mark)
VALUES (?, ?, ?);

