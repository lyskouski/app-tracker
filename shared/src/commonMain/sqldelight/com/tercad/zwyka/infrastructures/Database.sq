CREATE TABLE Habit (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    icon TEXT,
    color TEXT,
    remarks TEXT,
    createdAt INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    activeDays INTEGER NOT NULL DEFAULT 127
);

CREATE TABLE DayState (
    habitId INTEGER NOT NULL,
    date TEXT NOT NULL,
    mark TEXT NOT NULL,
    PRIMARY KEY (habitId, date),
    FOREIGN KEY (habitId) REFERENCES Habit(id)
);

-- Like Habit, but used only for scheduling in the calendar.
CREATE TABLE Intent (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    icon TEXT,
    color TEXT,
    remarks TEXT,
    createdAt INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    activeDays INTEGER NOT NULL DEFAULT 127
);

-- Belongs either to a Habit or to an Intent.
-- timeStart / timeEnd are minutes since midnight.
CREATE TABLE HabitTime (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    habitId INTEGER,
    intentId INTEGER,
    timeStart INTEGER NOT NULL,
    timeEnd INTEGER NOT NULL,
    note TEXT,
    activeDays INTEGER NOT NULL DEFAULT 127,
    -- 1: notify the user at timeStart.
    notify INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (habitId) REFERENCES Habit(id),
    FOREIGN KEY (intentId) REFERENCES Intent(id)
);

CREATE TABLE Setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

selectAllSettings:
SELECT *
FROM Setting;

upsertSetting:
INSERT OR REPLACE INTO Setting(key, value)
VALUES (?, ?);

deleteSetting:
DELETE FROM Setting
WHERE key = ?;

selectAllHabits:
SELECT *
FROM Habit
ORDER BY id;

insertHabit:
INSERT INTO Habit(title, icon, color, remarks, activeDays, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, CAST(strftime('%s', 'now') AS INTEGER) * 1000, CAST(strftime('%s', 'now') AS INTEGER) * 1000);

selectLastHabitId:
SELECT max(id)
FROM Habit;

updateHabit:
UPDATE Habit
SET title = ?, icon = ?, color = ?, remarks = ?, activeDays = ?, updatedAt = CAST(strftime('%s', 'now') AS INTEGER) * 1000
WHERE id = ?;

updateHabitActiveDays:
UPDATE Habit
SET activeDays = ?, updatedAt = CAST(strftime('%s', 'now') AS INTEGER) * 1000
WHERE id = ?;

touchHabit:
UPDATE Habit
SET updatedAt = CAST(strftime('%s', 'now') AS INTEGER) * 1000
WHERE id = ?;

deleteDayStatesForHabit:
DELETE FROM DayState
WHERE habitId = ?;

deleteHabit:
DELETE FROM Habit
WHERE id = ?;

selectDayStatesForDateRange:
SELECT *
FROM DayState
WHERE date BETWEEN ? AND ?
ORDER BY habitId, date;

deleteDayState:
DELETE FROM DayState
WHERE habitId = ? AND date = ?;

upsertDayState:
INSERT OR REPLACE INTO DayState(habitId, date, mark)
VALUES (?, ?, ?);

selectAllHabitTimes:
SELECT *
FROM HabitTime
ORDER BY timeStart, timeEnd;

insertHabitTime:
INSERT INTO HabitTime(habitId, intentId, timeStart, timeEnd, note, activeDays, notify)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateHabitTime:
UPDATE HabitTime
SET habitId = ?, intentId = ?, timeStart = ?, timeEnd = ?, note = ?, activeDays = ?, notify = ?
WHERE id = ?;

updateIntentActiveDays:
UPDATE Intent
SET activeDays = ?, updatedAt = CAST(strftime('%s', 'now') AS INTEGER) * 1000
WHERE id = ?;

selectAllIntents:
SELECT *
FROM Intent
ORDER BY id;

selectLastIntentId:
SELECT max(id)
FROM Intent;

insertIntent:
INSERT INTO Intent(title, activeDays, createdAt, updatedAt)
VALUES (?, ?, CAST(strftime('%s', 'now') AS INTEGER) * 1000, CAST(strftime('%s', 'now') AS INTEGER) * 1000);

updateIntentTitle:
UPDATE Intent
SET title = ?, updatedAt = CAST(strftime('%s', 'now') AS INTEGER) * 1000
WHERE id = ?;

-- Intents exist only while they are scheduled.
deleteUnusedIntents:
DELETE FROM Intent
WHERE id NOT IN (SELECT intentId FROM HabitTime WHERE intentId IS NOT NULL);

deleteHabitTime:
DELETE FROM HabitTime
WHERE id = ?;

deleteHabitTimesForHabit:
DELETE FROM HabitTime
WHERE habitId = ?;

-- Backup: every stored row, and inserts keeping the ids that skip existing rows.
selectAllDayStates:
SELECT *
FROM DayState
ORDER BY habitId, date;

selectAllHabitTimesById:
SELECT *
FROM HabitTime
ORDER BY id;

importHabit:
INSERT OR IGNORE INTO Habit(id, title, icon, color, remarks, createdAt, updatedAt, activeDays)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

importIntent:
INSERT OR IGNORE INTO Intent(id, title, icon, color, remarks, createdAt, updatedAt, activeDays)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

importHabitTime:
INSERT OR IGNORE INTO HabitTime(id, habitId, intentId, timeStart, timeEnd, note, activeDays, notify)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

importDayState:
INSERT OR IGNORE INTO DayState(habitId, date, mark)
VALUES (?, ?, ?);

importSetting:
INSERT OR IGNORE INTO Setting(key, value)
VALUES (?, ?);

